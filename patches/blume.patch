@@ -9,6 +9,17 @@ interface Props {
 }
 
 const { cssVars } = Astro.props;
+// Preload only the regular face of each family. Other weights and italics
+// still load when a page uses them, but they do not compete with the first paint.
+const preload = [{ style: "normal", weight: 400 }];
+// Geist is only the fallback for App Sans, so on telemetry.dev a Geist preload downloads a font no text uses.
+const appSansFallback = "--blume-ff-geist";
 ---
 
-{cssVars.map((cssVar) => <Font cssVariable={cssVar} preload />)}
+{/* theme.css loads App Sans from the app on the same origin, outside Astro's Fonts API. */}
+<link rel="preload" href="/fonts/app-sans-regular.woff2" as="font" type="font/woff2" crossorigin />
+{
+  cssVars.map((cssVar) => (
+    <Font cssVariable={cssVar} preload={cssVar === appSansFallback ? false : preload} />
+  ))
+}
