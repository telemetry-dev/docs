{
  "name": "telemetry-docs",
  "main": "./worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "telemetry.dev/docs*",
      "zone_name": "telemetry.dev"
    },
    {
      "pattern": "docs.telemetry.dev",
      "custom_domain": true
    }
  ]
}
