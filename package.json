{
  "name": "telemetry-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "blume dev",
    "build": "blume build && rm -rf .blume/cloudflare && mkdir -p .blume/cloudflare && cp -R dist .blume/cloudflare/docs && mv .blume/cloudflare/docs/_headers .blume/cloudflare/_headers",
    "test": "node --test",
    "preview": "blume preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "blume": "1.3.1"
  },
  "devDependencies": {
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@11.25.0"
}
