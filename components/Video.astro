---
// A silent screen recording from public/recordings/. It plays only when the reader starts it.
// Without JavaScript, the browser's own controls stay.
// The control bar uses Lucide icons (ISC), the set the docs already ship. Lucide centers the play
// triangle's box, which puts its centroid at x 10.3; the icon's viewBox moves the centroid to 12.
interface Props {
  src: string;
  poster: string;
  title: string;
}

const { poster, src, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<td-video class="td-video">
  <video
    src={`${base}/${src}`}
    poster={`${base}/${poster}`}
    aria-label={title}
    width="2560"
    height="1600"
    controls
    muted
    loop
    playsinline
    preload="none"></video>
  <button type="button" class="td-video-play" data-play aria-label="Play video">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path class="td-video-triangle" d="M8.5 5.5v13L19 12z"></path></svg>
  </button>
  <div class="td-video-bar" inert>
    <button type="button" data-toggle aria-label="Play video">
      <svg class="td-video-icon-pause" viewBox="0 0 24 24" aria-hidden="true">
        <rect width="5" height="18" x="14" y="3" rx="1"></rect>
        <rect width="5" height="18" x="5" y="3" rx="1"></rect>
      </svg>
      <svg class="td-video-icon-play" viewBox="-1.7 0 24 24" aria-hidden="true">
        <path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path>
      </svg>
    </button>
    <div class="td-video-track" data-track role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span data-progress></span>
    </div>
    <button type="button" data-fullscreen aria-label="Full screen">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3"></path>
      </svg>
    </button>
  </div>
</td-video>

<script>
  const SEEK_STEP_SECONDS = 5;

  class TdVideo extends HTMLElement {
    connectedCallback() {
      const video = this.querySelector("video")!;
      const play = this.querySelector<HTMLButtonElement>("[data-play]")!;
      const bar = this.querySelector<HTMLElement>(".td-video-bar")!;
      const toggle = this.querySelector<HTMLButtonElement>("[data-toggle]")!;
      const track = this.querySelector<HTMLElement>("[data-track]")!;
      const progress = this.querySelector<HTMLElement>("[data-progress]")!;
      const fullscreen = this.querySelector<HTMLButtonElement>("[data-fullscreen]")!;

      video.controls = false;
      this.dataset.enhanced = "";

      // play() rejects with AbortError when a pause interrupts loading, and the paused state is
      // already right. Any other failure hands the reader back the browser's own controls.
      const togglePlay = () => {
        if (!video.paused) return video.pause();
        video.play().catch((error) => {
          if (error?.name === "AbortError") return;
          video.controls = true;
          delete this.dataset.enhanced;
        });
      };
      const seekTo = (seconds: number) => {
        if (Number.isFinite(video.duration)) video.currentTime = Math.min(Math.max(seconds, 0), video.duration);
      };
      const clock = (seconds: number) =>
        `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;

      let frame = 0;
      const draw = () => {
        cancelAnimationFrame(frame);
        progress.style.transform = `scaleX(${video.duration ? video.currentTime / video.duration : 0})`;
        if (!video.paused) frame = requestAnimationFrame(draw);
      };
      const announce = () => {
        if (!video.duration) return;
        track.setAttribute("aria-valuenow", String(Math.round((video.currentTime / video.duration) * 100)));
        track.setAttribute("aria-valuetext", `${clock(video.currentTime)} of ${clock(video.duration)}`);
      };

      video.addEventListener("play", () => {
        this.dataset.started = "";
        this.dataset.playing = "";
        bar.inert = false;
        toggle.setAttribute("aria-label", "Pause video");
        // The overlay button disappears once playback starts, so keep keyboard focus in the player.
        if (document.activeElement === play) toggle.focus();
        draw();
      });
      video.addEventListener("pause", () => {
        delete this.dataset.playing;
        toggle.setAttribute("aria-label", "Play video");
        draw();
      });
      video.addEventListener("seeked", draw);
      video.addEventListener("timeupdate", announce);

      play.addEventListener("click", togglePlay);
      toggle.addEventListener("click", togglePlay);
      // In full screen the browser's controls already toggle playback on a click.
      video.addEventListener("click", () => {
        if (!video.controls) togglePlay();
      });

      track.addEventListener("click", (event) => {
        const box = track.getBoundingClientRect();
        seekTo(((event.clientX - box.left) / box.width) * video.duration);
      });
      track.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight" || event.key === "ArrowUp") seekTo(video.currentTime + SEEK_STEP_SECONDS);
        else if (event.key === "ArrowLeft" || event.key === "ArrowDown") seekTo(video.currentTime - SEEK_STEP_SECONDS);
        else if (event.key === "Home") seekTo(0);
        else if (event.key === "End") seekTo(video.duration);
        else return;
        event.preventDefault();
      });

      fullscreen.addEventListener("click", () => {
        const webkitVideo = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
        if (video.requestFullscreen) void video.requestFullscreen().catch(() => {});
        else webkitVideo.webkitEnterFullscreen?.();
      });
      // The browser's own controls are the only ones that show in full screen.
      document.addEventListener("fullscreenchange", () => {
        video.controls = document.fullscreenElement === video;
      });
    }
  }

  if (!customElements.get("td-video")) customElements.define("td-video", TdVideo);
</script>

<style>
  .td-video {
    position: relative;
    display: block;
    width: 100%;
    line-height: 0;
    border-radius: var(--radius-blume, 4px);
    overflow: hidden;
  }

  .td-video video {
    display: block;
    width: 100%;
    height: auto;
  }

  .td-video[data-enhanced] video {
    cursor: pointer;
  }

  .td-video:not([data-enhanced]) :is(.td-video-play, .td-video-bar) {
    display: none;
  }

  .td-video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: clamp(44px, 11%, 64px);
    aspect-ratio: 1;
    padding: 0;
    transform: translate(-50%, -50%);
    border: 0;
    border-radius: 999px;
    color: #fff;
    background: rgb(0 0 0 / 0.78);
    box-shadow: 0 6px 20px -6px rgb(0 0 0 / 0.45);
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: transform 160ms cubic-bezier(0.2, 0, 0, 1), background-color 160ms;
  }

  .td-video-play svg {
    width: 42%;
    height: 42%;
  }

  /* A triangle looks centered when its centroid is, not its bounding box: the path puts the
     centroid at (12, 12). The stroke rounds the corners without moving it. */
  .td-video-triangle {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .td-video-play:hover {
    transform: translate(-50%, -50%) scale(1.06);
    background: rgb(0 0 0 / 0.88);
  }

  .td-video[data-playing] .td-video-play,
  .td-video[data-started] .td-video-play {
    display: none;
  }

  .td-video-bar {
    position: absolute;
    inset-inline: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 999px;
    color: #fff;
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(6px);
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition: opacity 160ms, transform 160ms cubic-bezier(0.2, 0, 0, 1);
  }

  .td-video[data-started]:is(:hover, :focus-within) .td-video-bar,
  .td-video[data-started]:not([data-playing]) .td-video-bar {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  @media (hover: none) {
    .td-video[data-started] .td-video-bar {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  .td-video-bar button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .td-video-bar button:hover {
    background: rgb(255 255 255 / 0.14);
  }

  .td-video-bar svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .td-video-bar svg:is(.td-video-icon-play, .td-video-icon-pause) {
    display: none;
  }

  .td-video:not([data-playing]) .td-video-icon-play,
  .td-video[data-playing] .td-video-icon-pause {
    display: block;
  }

  .td-video-track {
    position: relative;
    flex: 1;
    height: 4px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.28);
    cursor: pointer;
  }

  .td-video-track::before {
    content: "";
    position: absolute;
    inset: -10px 0;
  }

  .td-video-track span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Forced colors paint both backgrounds with Canvas, which would hide the track and its fill. */
  @media (forced-colors: active) {
    .td-video-track {
      border: 1px solid CanvasText;
    }

    .td-video-track span {
      forced-color-adjust: none;
      background: Highlight;
    }
  }

  .td-video :is(button, .td-video-track):focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .td-video-play,
    .td-video-bar {
      transition: none;
    }
  }
</style>
