---
// Mirrors the span tree of the dashboard's trace page (apps/web/src/components/trace/span-tree.tsx,
// span-kind.ts, and timeline.ts in the product repository): its columns, indents, type chips,
// colors, time axis, and duration labels. If the dashboard's span tree changes, update this figure
// to match.
import { buildTicks, formatSpanDuration, SPAN_TYPES } from "./model.js";

type SpanType = keyof typeof SPAN_TYPES;

interface Span {
  name: string;
  type: SpanType;
  depth?: number;
  /** Milliseconds from the trace start. */
  start: number;
  end: number;
  error?: boolean;
}

interface Props {
  title: string;
  caption?: string;
  spans: Span[];
}

const { title, caption, spans } = Astro.props;

// The dashboard's categorical colors, in the order span-kind.ts assigns them.
const COLORS: Record<SpanType, string> = {
  agent: "#4290f0",
  tool: "#f5b647",
  embeddings: "#e8649d",
  retrieval: "#e8649d",
  model: "#8d58ee",
  mcp: "#50c3b6",
  http: "#d37536",
  function: "#cbcbcb",
};
const ERROR_COLOR = "#fc574a";

// Drawn for this figure on a 24px grid in the style of the dashboard's span-type icons: mostly
// square corners, round caps, and a 1.5 stroke set by .td-tree svg. The dashboard's own icons are
// licensed for the product only, so do not copy them here.
const ICONS: Record<SpanType, string> = {
  agent:
    '<rect x="3.5" y="8" width="17" height="11.5" rx="3.5" /><path d="M12 8V5.5" /><circle cx="12" cy="4" r="1.5" /><circle cx="9" cy="13.75" r="1.25" fill="currentColor" stroke="none" /><circle cx="15" cy="13.75" r="1.25" fill="currentColor" stroke="none" />',
  model:
    '<rect x="6" y="6" width="12" height="12" /><rect x="9.5" y="9.5" width="5" height="5" /><path d="M9.5 3v3M14.5 3v3M9.5 18v3M14.5 18v3M3 9.5h3M3 14.5h3M18 9.5h3M18 14.5h3" />',
  tool:
    '<rect x="3" y="10" width="18" height="10" /><path d="M8.5 10V6h7v4M3 14h18M12 12.5v3" />',
  mcp:
    '<rect x="3.5" y="9.5" width="5" height="5" /><rect x="15.5" y="3.5" width="5" height="5" /><rect x="15.5" y="15.5" width="5" height="5" /><path d="M8.5 11l7-4M8.5 13l7 4" />',
  embeddings:
    '<path d="M12 3.5l2.4 6.1 6.1 2.4-6.1 2.4-2.4 6.1-2.4-6.1-6.1-2.4 6.1-2.4z" />',
  retrieval:
    '<rect x="3.5" y="5.5" width="17" height="6.5" /><rect x="3.5" y="12" width="17" height="6.5" /><path d="M13.5 8.75h3.5M13.5 15.25h3.5" /><circle cx="7" cy="8.75" r="1.25" fill="currentColor" stroke="none" /><circle cx="7" cy="15.25" r="1.25" fill="currentColor" stroke="none" />',
  http:
    '<circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="3.75" ry="9" /><path d="M3 12h18" />',
  function:
    '<path d="M9 4.5H8a2 2 0 0 0-2 2v3a2.5 2.5 0 0 1-2 2.5 2.5 2.5 0 0 1 2 2.5v3a2 2 0 0 0 2 2h1M15 4.5h1a2 2 0 0 1 2 2v3a2.5 2.5 0 0 0 2 2.5 2.5 2.5 0 0 0-2 2.5v3a2 2 0 0 1-2 2h-1" />',
};
const CHEVRON = '<path d="M7.5 9.75l4.5 4.5 4.5-4.5" />';
const ERROR_ICON = '<circle cx="12" cy="12" r="9" /><path d="M12 7.5v5M12 16.25v.25" />';

// The timeline column's plot runs from 8px after its start to 16px before its end (timeline.ts).
const at = (share: number) => `calc(8px + (100% - 24px) * ${Number(share.toFixed(6))})`;

const total = Math.max(...spans.map((span) => span.end));
const ticks = buildTicks(total);

const rows = spans.map((span, index) => {
  if (!Object.hasOwn(SPAN_TYPES, span.type)) throw new Error(`TraceFigure: unknown span type: ${span.type}`);
  const depth = span.depth ?? 0;
  const next = spans[index + 1];
  return {
    ...span,
    depth,
    hasChildren: next !== undefined && (next.depth ?? 0) > depth,
    color: span.error ? ERROR_COLOR : COLORS[span.type],
    left: at(span.start / total),
    width: `max(3px, (100% - 24px) * ${Number(((span.end - span.start) / total).toFixed(6))})`,
    duration: formatSpanDuration(span.end - span.start),
  };
});
---

<figure class="td-figure not-prose">
  <div class="td-figure-card">
    <p class="td-figure-title">{title}</p>
    <div class="td-tree" role="tree" aria-label={title}>
      <div class="td-tree-row td-tree-head" aria-hidden="true">
        <span class="td-tree-count">{spans.length} {spans.length === 1 ? "span" : "spans"}</span>
        <div class="td-tree-time">
          {
            ticks.map((tick) => (
              <span class="td-tree-tick" style={`left: ${tick.share === 0 ? at(0) : `calc(${at(tick.share)} + 4px)`}`}>
                {tick.label}
              </span>
            ))
          }
        </div>
        <span />
      </div>
      {
        rows.map((row) => (
          <div
            class:list={["td-tree-row", { "td-tree-row--error": row.error }]}
            role="treeitem"
            aria-level={row.depth + 1}
            aria-label={`${row.name}, ${SPAN_TYPES[row.type]}, ${row.duration}${row.error ? ", error" : ""}`}
            style={`--td-bar: ${row.color}; --td-chip: ${COLORS[row.type]}`}
          >
            <div class="td-tree-name" style={`padding-inline-start: ${8 + 16 * row.depth}px`}>
              <span class="td-tree-toggle">
                {row.hasChildren && <svg viewBox="0 0 24 24" set:html={CHEVRON} />}
              </span>
              <span class="td-tree-chip">
                <svg viewBox="0 0 24 24" set:html={ICONS[row.type]} />
              </span>
              <span class="td-tree-label">{row.name}</span>
              {row.error && <svg class="td-tree-error" viewBox="0 0 24 24" set:html={ERROR_ICON} />}
            </div>
            <div class="td-tree-time">
              {ticks.map((tick) =>
                tick.share > 0 ? <span class="td-tree-grid" style={`left: ${at(tick.share)}`} /> : null,
              )}
              <span class="td-tree-bar" style={`left: ${row.left}; width: ${row.width}`} />
            </div>
            <span class="td-tree-duration">{row.duration}</span>
          </div>
        ))
      }
    </div>
  </div>
  {caption && <figcaption class="td-figure-caption">{caption}</figcaption>}
</figure>

<style>
  .td-tree {
    background: var(--blume-background);
    border: 1px solid var(--blume-border);
    border-radius: 0.5rem;
    display: grid;
    grid-template-columns: fit-content(44%) minmax(0, 1fr) 72px;
    overflow: hidden;
  }

  .td-tree svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .td-tree-row {
    align-items: center;
    border-bottom: 1px solid var(--blume-border);
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    height: 32px;
  }

  .td-tree-row:last-child {
    border-bottom: 0;
  }

  .td-tree-head {
    height: 28px;
  }

  .td-tree-count,
  .td-tree-tick {
    color: var(--blume-muted-foreground);
    font-size: 12px;
    line-height: 17px;
    white-space: nowrap;
  }

  .td-tree-count {
    padding-inline-start: 11px;
  }

  .td-tree-tick {
    font-family: var(--font-mono);
    position: absolute;
    top: 5px;
  }

  .td-tree-name {
    align-items: center;
    display: flex;
    gap: 6px;
    height: 32px;
    min-width: 0;
    overflow: hidden;
    padding-inline-end: 34px;
  }

  .td-tree-toggle {
    align-items: center;
    color: var(--blume-muted-foreground);
    display: flex;
    flex: none;
    height: 16px;
    justify-content: center;
    width: 16px;
  }

  .td-tree-toggle svg {
    height: 12px;
    width: 12px;
  }

  .td-tree-chip {
    align-items: center;
    background: color-mix(in oklab, var(--td-chip) 24%, transparent);
    border-radius: 3px;
    color: var(--blume-foreground);
    display: flex;
    flex: none;
    height: 20px;
    justify-content: center;
    width: 20px;
  }

  .td-tree-chip svg {
    height: 12px;
    width: 12px;
  }

  .td-tree-label {
    color: var(--blume-foreground);
    font-size: 12px;
    line-height: 17px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .td-tree-error {
    color: var(--td-bar);
    flex: none;
    height: 14px;
    width: 14px;
  }

  .td-tree-row--error .td-tree-label,
  .td-tree-row--error .td-tree-duration {
    color: var(--td-bar);
  }

  .td-tree-time {
    height: 100%;
    min-width: 0;
    overflow: hidden;
    position: relative;
  }

  .td-tree-grid {
    background: var(--blume-border);
    inset-block: 0;
    position: absolute;
    width: 1px;
  }

  .td-tree-bar {
    background: var(--td-bar);
    border-radius: 2px;
    height: 10px;
    position: absolute;
    top: 11px;
  }

  .td-tree-duration {
    color: var(--blume-muted-foreground);
    font-family: var(--font-mono);
    font-size: 12px;
    padding-inline-end: 11px;
    text-align: end;
    white-space: nowrap;
  }

  /* The dashboard hides the timeline on narrow screens and keeps the names and durations. */
  @media (max-width: 40rem) {
    .td-tree {
      grid-template-columns: minmax(0, 1fr) 72px;
    }

    .td-tree-time {
      display: none;
    }
  }
</style>
