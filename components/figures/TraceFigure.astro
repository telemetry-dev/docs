  ]),
  tool: stroke([
    "M13.6672 7.84076C13.8108 8.42155 14.1097 8.97368 14.568 9.43193C15.0262 9.89017 15.5783 10.189 16.1591 10.3327M13.6672 7.84076C13.3547 6.57723 13.777 5.17802 14.8916 4.31463L17.2341 2.5L16.915 3.11595C16.3248 4.25512 16.5402 5.64531 17.4474 6.55251C18.3546 7.45971 19.7448 7.67508 20.8839 7.0849L21.4999 6.7658L19.6853 9.10832C18.8219 10.2229 17.4227 10.6452 16.1591 10.3327M13.6672 7.84076L3.56706 16.609C3.35292 16.7949 3.24585 16.8879 3.16484 16.9733C2.11129 18.0844 2.44365 19.5888 3.42735 20.5725C4.41105 21.5562 5.91545 21.8886 7.02658 20.835C7.11182 20.7542 7.20455 20.6474 7.38963 20.4342L16.1591 10.3327M21.1556 21.3911L15.999 16.2346M5.44831 9.90825L3.47739 7.93731C3.14894 7.60886 2.98471 7.44463 2.86906 7.28546C2.23245 6.40924 2.23245 5.22275 2.86906 4.34653C3.19975 3.89137 3.67409 3.41703 4.12925 3.08634C5.00547 2.44973 6.19196 2.44973 7.06817 3.08634C7.22735 3.20199 7.39158 3.36622 7.72003 3.69467L9.99903 5.97367",
  ]),
  span: stroke([
    "M17.0004 18C18.8177 16.423 20.4474 14.5771 21.848 12.5102C22.0511 12.2104 22.0511 11.7897 21.848 11.4899C20.4474 9.42298 18.8177 7.57705 17.0004 6.00004M7.00391 18C5.18658 16.423 3.5569 14.5771 2.15627 12.5101C1.95312 12.2103 1.95312 11.7897 2.15627 11.4899C3.5569 9.42294 5.18658 7.57701 7.00391 6M14.0039 4.00098L10.0039 20.001",
  ]),
  embedding: stroke([
    "M12.9 3C13.5401 8.03653 15.5305 11.1418 21 12C15.8102 12.8143 13.5701 15.7277 12.9 21C12.2299 15.7277 9.98984 12.8143 4.8 12C9.98984 11.1857 12.2299 8.2723 12.9 3Z",
    "M5.7 3C5.94808 4.50612 6.8515 5.44494 8.4 5.7C6.8515 5.95506 5.94808 6.89388 5.7 8.4C5.45192 6.89388 4.5485 5.95506 3 5.7C4.50612 5.45192 5.44494 4.5485 5.7 3Z",
  ]),
  retrieval: stroke([
    "M20 5.7V12M20 5.7C20 7.19117 16.4183 8.4 12 8.4C7.58172 8.4 4 7.19117 4 5.7M20 5.7C20 4.20883 16.4183 3 12 3C7.58172 3 4 4.20883 4 5.7M20 12V18.1312C20 19.7156 16.4183 21 12 21C7.58172 21 4 19.7156 4 18.1312V12M20 12C20 13.4912 16.4183 14.7 12 14.7C7.58172 14.7 4 13.4912 4 12M4 12V5.7M16 11H16.01M16 17H16.01",
  ]),
};

// Geometry from the dashboard: a 16px gutter per depth, an 8px cell pad, and a 6px flex gap.
const GUTTER = 16;
const railX = (column: number) => 8 + 6 + column * GUTTER + GUTTER / 2;

const total = Math.max(...spans.map((span) => span.end));
const ticks = buildTicks(total);

const rows = spans.map((span, index) => {
  const depth = span.depth ?? 0;
  const later = spans.slice(index + 1);
  const children = later.findIndex((next) => (next.depth ?? 0) <= depth);
  const childCount = (children === -1 ? later : later.slice(0, children)).filter(
    (next) => (next.depth ?? 0) === depth + 1,
  ).length;
  // A rail at column c runs through this row when the ancestor at depth c + 1 has a later sibling.
  const hasLaterSibling = (atIndex: number, atDepth: number) => {
    for (const next of spans.slice(atIndex + 1)) {
      const nextDepth = next.depth ?? 0;
      if (nextDepth < atDepth) return false;
      if (nextDepth === atDepth) return true;
    }
    return false;
  };
  const ancestorIndex = (targetDepth: number) => {
    for (let at = index; at >= 0; at--) if ((spans[at].depth ?? 0) === targetDepth) return at;
    return index;
  };
  const rails = Array.from({ length: Math.max(depth - 1, 0) }, (_, column) =>
    hasLaterSibling(ancestorIndex(column + 1), column + 1),
  );
  const offset = Math.min((span.start / total) * 100, 99.7);
  const width = Math.min(Math.max(((span.end - span.start) / total) * 100, 0.3), 100 - offset);
  return {
    ...span,
    depth,
    childCount,
    rails,
    isLast: !hasLaterSibling(index, depth),
    color: span.error ? ERROR_COLOR : COLORS[span.type],
    operation: span.operation ?? SPAN_TYPES[span.type],
    offset,
    width,
    duration: formatMs(span.end - span.start),
    labelInside: width > 24,
    labelOnLeft: offset > 50,
  };
});
const legend = [...new Set(spans.map((span) => span.type))];
---

<figure class="td-figure not-prose">
  <div class="td-figure-card">
    <p class="td-figure-title">{title}</p>
    <div class="td-wf-legend" aria-hidden="true">
      {
        legend.map((type) => (
          <span>
            <span class="td-wf-legend-dot" style={`background: ${COLORS[type]}`} />
            {SPAN_TYPES[type]}
          </span>
        ))
      }
    </div>
    <div class="td-wf-scroll">
      <div class="td-wf" role="tree" aria-label={title}>
        <div class="td-wf-row td-wf-head" aria-hidden="true">
          <div class="td-wf-cell">Span</div>
          <div class="td-wf-cell td-wf-sep">Operation</div>
          <div class="td-wf-sep td-wf-time">
            <div class="td-wf-inset">
              {
                ticks.map((tick) => (
                  <span>
                    <span class="td-wf-tick-mark" style={`left: ${tick.percent}%`} />
                    <span class="td-wf-tick-label" style={`left: ${tick.percent}%`}>{tick.label}</span>
                  </span>
                ))
              }
            </div>
          </div>
        </div>
        {
          rows.map((row) => (
            <div
              class="td-wf-row"
              role="treeitem"
              aria-level={row.depth + 1}
              aria-label={`${row.name}, ${SPAN_TYPES[row.type]}, ${row.operation}, ${row.duration}`}
              style={`--td-span: ${row.color}`}
            >
              <div class="td-wf-cell td-wf-span">
                {row.rails.map((rail, column) =>
                  rail ? <span class="td-wf-line td-wf-rail" style={`left: ${railX(column)}px`} /> : null,
                )}
                {row.depth > 0 && (
                  <>
                    <span
                      class:list={["td-wf-line", row.isLast ? "td-wf-tee-end" : "td-wf-rail"]}
                      style={`left: ${railX(row.depth - 1)}px`}
                    />
                    <span
                      class="td-wf-line td-wf-branch"
                      style={`left: ${railX(row.depth - 1) + (row.isLast ? 0 : 1)}px; width: ${(row.childCount > 0 ? GUTTER / 2 : GUTTER - 3) - (row.isLast ? 0 : 1)}px`}
                    />
                  </>
                )}
                {row.childCount > 0 && (
                  <span class="td-wf-line td-wf-down" style={`left: ${railX(row.depth)}px`} />
                )}
                <span style={`width: ${row.depth * GUTTER}px`} class="td-wf-indent" />
                {row.childCount > 0 ? (
                  <span class="td-wf-hub">{row.childCount}</span>
                ) : (
                  <span class="td-wf-leaf">
                    <span />
                  </span>
                )}
                <svg class="td-wf-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" set:html={ICONS[row.type]} />
                <span class:list={["td-wf-name", { "td-wf-name--error": row.error }]}>{row.name}</span>
              </div>
              <div class="td-wf-cell td-wf-sep td-wf-op">{row.operation}</div>
              <div class="td-wf-sep td-wf-time">
                <div class="td-wf-inset">
                  {ticks.map((tick) =>
                    tick.percent > 0 ? <span class="td-wf-grid" style={`left: ${tick.percent}%`} /> : null,
                  )}
                  <div class="td-wf-bar" style={`left: ${row.offset}%; width: ${row.width}%`}>
                    {row.labelInside && <span>{row.duration}</span>}
                  </div>
                  {!row.labelInside && (
                    <span
                      class="td-wf-duration"
                      style={
                        row.labelOnLeft
                          ? `right: ${100 - row.offset}%; margin-right: 6px`
                          : `left: ${row.offset + row.width}%; margin-left: 6px`
                      }
                    >
                      {row.duration}
                    </span>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  {caption && <figcaption class="td-figure-caption">{caption}</figcaption>}
</figure>

<style>
  .td-wf-legend {
    color: var(--blume-muted-foreground);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.75rem;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .td-wf-legend > span {
    align-items: center;
    display: flex;
    gap: 0.375rem;
  }

  .td-wf-legend-dot {
    border-radius: 999px;
    height: 0.375rem;
    width: 0.375rem;
  }

  .td-wf-scroll {
    background: var(--blume-background);
    border: 1px solid var(--blume-border);
    border-radius: 0.5rem;
    overflow-x: auto;
  }

  .td-wf {
    min-width: calc(13rem + 7rem + 12rem);
  }

  .td-wf-row {
    border-bottom: 1px solid var(--blume-border);
    display: grid;
    grid-template-columns: 13rem 7rem minmax(12rem, 1fr);
    height: 1.75rem;
  }

  .td-wf-row:last-child {
    border-bottom: 0;
  }

  .td-wf-head {
    color: var(--blume-muted-foreground);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .td-wf-cell {
    align-items: center;
    display: flex;
    min-width: 0;
    overflow: hidden;
    padding-inline: 0.5rem;
    position: relative;
  }

  .td-wf-sep {
    border-inline-start: 1px solid var(--blume-border);
  }

  .td-wf-time {
    position: relative;
  }

  .td-wf-inset {
    inset-block: 0;
    inset-inline: 0.5rem 2rem;
    position: absolute;
  }

  .td-wf-tick-mark,
  .td-wf-grid {
    background: var(--blume-border);
    position: absolute;
    width: 1px;
  }

  .td-wf-tick-mark {
    bottom: 0;
    height: 0.375rem;
  }

  .td-wf-grid {
    inset-block: 0;
  }

  .td-wf-tick-label {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    padding-inline-start: 0.25rem;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
  }

  .td-wf-span {
    gap: 0.375rem;
  }

  .td-wf-line {
    background: var(--blume-border);
    position: absolute;
    width: 1px;
  }

  .td-wf-rail {
    inset-block: 0;
  }

  .td-wf-tee-end {
    height: 50%;
    top: 0;
  }

  .td-wf-branch {
    height: 1px;
    top: 50%;
  }

  .td-wf-down {
    bottom: 0;
    top: calc(50% + 8px);
  }

  .td-wf-indent {
    flex: none;
  }

  .td-wf-hub,
  .td-wf-leaf {
    align-items: center;
    display: flex;
    flex: none;
    height: 1rem;
    justify-content: center;
    position: relative;
    width: 1rem;
    z-index: 1;
  }

  .td-wf-hub {
    background: color-mix(in oklab, var(--td-span) 18%, transparent);
    border-radius: 999px;
    color: var(--td-span);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .td-wf-leaf > span {
    background: color-mix(in oklab, var(--td-span) 45%, var(--blume-background));
    border-radius: 999px;
    height: 0.375rem;
    width: 0.375rem;
  }

  .td-wf-icon {
    color: var(--td-span);
    flex: none;
    height: 0.875rem;
    width: 0.875rem;
  }

  .td-wf-name {
    color: var(--blume-foreground);
    font-size: 0.75rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .td-wf-name--error {
    color: var(--td-span);
  }

  .td-wf-op {
    color: var(--blume-muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
    line-height: 1.75rem;
  }

  .td-wf-bar {
    background: var(--td-span);
    border-radius: 3px;
    height: 0.875rem;
    min-width: 2px;
    overflow: hidden;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .td-wf-bar > span {
    color: rgb(255 255 255 / 0.95);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    line-height: 0.875rem;
    overflow: hidden;
    padding-inline: 0.375rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .td-wf-duration {
    color: var(--blume-muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .td-wf {
      min-width: 0;
    }

    .td-wf-row {
      grid-template-columns: 10.5rem minmax(7rem, 1fr);
    }

    .td-wf-row > .td-wf-cell.td-wf-sep {
      display: none;
    }
  }
</style>
