---
// Mirrors the dashboard's span waterfall (apps/web/src/components/trace/span-waterfall.tsx and
// span-ui.ts in the product repository): its columns, connectors, icons, colors, tick steps, and
// duration labels. If the dashboard's waterfall changes, update this figure to match.
import { buildTicks, formatMs, SPAN_TYPES } from "./model.js";

type SpanType = keyof typeof SPAN_TYPES;

interface Span {
  name: string;
  type: SpanType;
  depth?: number;
  /** Milliseconds from the trace start. */
  start: number;
  end: number;
  /** The Operation column: the span's model, tool name, or agent name. Defaults to the type label. */
  operation?: string;
  error?: boolean;
}

interface Props {
  title: string;
  caption?: string;
  spans: Span[];
}

const { title, caption, spans } = Astro.props;

const COLORS: Record<SpanType, string> = {
  agent: "oklch(0.68 0.17 30)",
  generation: "oklch(0.7 0.16 300)",
  tool: "oklch(0.72 0.15 130)",
  span: "oklch(0.72 0.15 160)",
  embedding: "oklch(0.7 0.15 330)",
  retrieval: "oklch(0.7 0.13 200)",
};
const ERROR_COLOR = "oklch(0.58 0.22 27)";

const stroke = (paths: string[]) =>
  paths
    .map((d) => `<path d="${d}" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />`)
    .join("");
