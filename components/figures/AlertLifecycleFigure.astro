---
import { ALERT_EXAMPLE, ALERT_RULES, alertTimeline, alertTimelineEvents } from "./model.js";

interface Props {
  title: string;
  caption?: string;
}

const { title, caption } = Astro.props;
const items = alertTimeline(ALERT_EXAMPLE);
const widths = items.map((item) => (item.kind === "gap" ? 2.25 : 1));
const columns = widths.map((width) => `${width}fr`).join(" ");
const railInset = `${50 / widths.reduce((sum, width) => sum + width, 0)}%`;

const bands: { state: string; start: number; end: number }[] = [];
items.forEach((item, index) => {
  const last = bands.at(-1);
  if (last && last.state === item.state) last.end = index + 2;
  else bands.push({ state: item.state, start: index + 1, end: index + 2 });
});
const bandLabels: Record<string, string> = { open: "Open", quiet: `Quiet, ${ALERT_RULES.quietMinutes} min` };
---

<figure class="td-figure td-alert-figure not-prose">
  <div class="td-figure-card">
    <p class="td-figure-title">{title}</p>
    <div class="td-alert" style={`grid-template-columns: ${columns}; --td-rail-inset: ${railInset}`} aria-hidden="true">
      {
        items.map((item, index) =>
          item.kind === "gap" ? (
            <span class="td-alert-gap" style={`grid-column: ${index + 1}`}>
              {ALERT_RULES.reminderHours} h
            </span>
          ) : (
            <span class="td-alert-check" style={`grid-column: ${index + 1}`} data-breached={item.breached ? "" : undefined} />
          ),
        )
      }
      {
        bands
          .filter((band) => band.state !== "none")
          .map((band) => (
            <span class="td-alert-band" data-state={band.state} style={`grid-column: ${band.start} / ${band.end}`}>
              {bandLabels[band.state]}
            </span>
          ))
      }
      {
        items.map(
          (item, index) =>
            item.email && (
              <span class="td-alert-email" style={`grid-column: ${index + 1}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
                </svg>
                <span>{item.email}</span>
              </span>
            ),
        )
      }
    </div>
    <ol class="td-sr-only">
      {alertTimelineEvents().map((event) => <li>{event}</li>)}
    </ol>
    <p class="td-alert-legend" aria-hidden="true">
      <span><span class="td-alert-check" data-breached="" />Breached check</span>
      <span><span class="td-alert-check" />Healthy check</span>
      <span>One check every {ALERT_RULES.checkMinutes} minutes</span>
    </p>
  </div>
  {caption && <figcaption class="td-figure-caption">{caption}</figcaption>}
</figure>

<style>
  .td-alert-figure {
    --td-alert-red: oklch(0.58 0.21 27);
  }

  :global(:root[data-theme="dark"]) .td-alert-figure {
    --td-alert-red: oklch(0.7 0.18 25);
  }

  .td-alert {
    display: grid;
    font-size: 0.6875rem;
    grid-template-rows: 1.25rem 1.5rem auto;
    line-height: 1.3;
    position: relative;
    row-gap: 0.625rem;
  }

  /* The rail runs from the first check to the last; the gap label covers it where time is skipped. */
  .td-alert::before {
    background: var(--blume-border);
    content: "";
    height: 1px;
    left: var(--td-rail-inset);
    position: absolute;
    right: var(--td-rail-inset);
    top: 0.625rem;
  }

  .td-alert-check {
    align-self: center;
    background: var(--blume-background);
    border: 1.5px solid var(--td-accent);
    border-radius: 999px;
    box-sizing: border-box;
    display: inline-block;
    grid-row: 1;
    height: 0.625rem;
    justify-self: center;
    position: relative;
    width: 0.625rem;
  }

  .td-alert-check[data-breached] {
    background: var(--td-alert-red);
    border-color: var(--td-alert-red);
  }

  .td-alert-gap {
    align-self: center;
    background: color-mix(in oklab, var(--blume-muted) 45%, var(--blume-background));
    color: var(--blume-muted-foreground);
    grid-row: 1;
    justify-self: center;
    padding-inline: 0.25rem;
    position: relative;
    white-space: nowrap;
  }

  .td-alert-band {
    align-items: center;
    border-radius: 0.3125rem;
    display: flex;
    grid-row: 2;
    justify-content: center;
    margin-inline: 0.125rem;
    overflow: hidden;
    white-space: nowrap;
  }

  .td-alert-band[data-state="open"] {
    background: color-mix(in oklab, var(--td-alert-red) 16%, var(--blume-background));
    color: var(--td-alert-red);
    font-weight: 500;
  }

  .td-alert-band[data-state="quiet"] {
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in oklab, var(--blume-border) 70%, transparent) 0 1px,
      transparent 1px 6px
    );
    box-shadow: inset 0 0 0 1px var(--blume-border);
    color: var(--blume-muted-foreground);
  }

  .td-alert-email {
    align-items: center;
    color: var(--blume-foreground);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    grid-row: 3;
    justify-self: center;
    white-space: nowrap;
    width: 0;
  }

  .td-alert-email svg {
    color: var(--blume-muted-foreground);
    flex: none;
    height: 0.875rem;
    width: 0.875rem;
  }

  .td-alert-legend {
    color: var(--blume-muted-foreground);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.6875rem;
    gap: 0.25rem 1rem;
    margin: 1rem 0 0;
  }

  .td-alert-legend > span {
    align-items: center;
    display: inline-flex;
    gap: 0.375rem;
  }

  .td-sr-only {
    clip: rect(0 0 0 0);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>
