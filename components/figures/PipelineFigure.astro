---
import { PIPELINE } from "./model.js";

interface Props {
  title: string;
  caption?: string;
  /** `privacy` shows where content is removed and dims the stages that do not remove any. */
  focus?: "privacy";
}

const { title, caption, focus } = Astro.props;
const privacy = focus === "privacy";
const ingestHasPrivacy = PIPELINE.ingest.some((stage) => stage.privacy);
const codeSpans = (text: string) =>
  text.split(/(`[^`]+`)/u).map((piece) => ({ code: piece.startsWith("`"), text: piece.replaceAll("`", "") }));
---

<figure class:list={["td-figure not-prose", { "td-pipeline--privacy": privacy }]}>
  <div class="td-figure-card">
    <p class="td-figure-title">{title}</p>
    <ol class="td-pipeline">
      <li class="td-stage" data-privacy={privacy && PIPELINE.app.privacy ? "" : undefined}>
        <p class="td-stage-zone">In your process</p>
        <p class="td-stage-title">{PIPELINE.app.title}</p>
        <p class="td-stage-detail">{PIPELINE.app.detail}</p>
        {
          privacy && (
            <p class="td-stage-privacy">
              {codeSpans(PIPELINE.app.privacy).map((piece) => (piece.code ? <code>{piece.text}</code> : piece.text))}
            </p>
          )
        }
      </li>
      <li class="td-link" aria-label={PIPELINE.transport}>
        <span class="td-link-line" aria-hidden="true" />
        <span class="td-link-label">{PIPELINE.transport}</span>
      </li>
      <li class="td-stage td-stage--group" data-privacy={privacy && ingestHasPrivacy ? "" : undefined}>
        <p class="td-stage-zone">telemetry.dev ingest</p>
        <ol class="td-steps">
          {
            PIPELINE.ingest.map((stage) => (
              <li class="td-step" data-privacy={privacy && stage.privacy ? "" : undefined}>
                <p class="td-stage-title">{stage.title}</p>
                <p class="td-stage-detail">{stage.detail}</p>
                {privacy && stage.privacy && <p class="td-stage-privacy">{stage.privacy}</p>}
              </li>
            ))
          }
        </ol>
      </li>
      <li class="td-link" aria-hidden="true">
        <span class="td-link-line" />
      </li>
      <li class="td-stage" data-privacy={privacy && PIPELINE.store.privacy ? "" : undefined}>
        <p class="td-stage-zone">telemetry.dev</p>
        <p class="td-stage-title">{PIPELINE.store.title}</p>
        <p class="td-stage-detail">{PIPELINE.store.detail}</p>
        {privacy && <p class="td-stage-privacy">{PIPELINE.store.privacy}</p>}
      </li>
    </ol>
  </div>
  {caption && <figcaption class="td-figure-caption">{caption}</figcaption>}
</figure>

<style>
  .td-pipeline,
  .td-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .td-pipeline {
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .td-stage,
  .td-step {
    background: var(--blume-background);
    border: 1px solid var(--blume-border);
    border-radius: calc(var(--blume-radius) * 0.75);
    padding: 0.75rem 0.875rem;
  }

  .td-stage--group {
    background: transparent;
    border-style: dashed;
    padding: 0.75rem;
  }

  .td-steps {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    margin-top: 0.5rem;
  }

  .td-step {
    counter-increment: td-step;
  }

  .td-steps {
    counter-reset: td-step;
  }

  .td-step .td-stage-title::before {
    color: var(--blume-muted-foreground);
    content: counter(td-step) ". ";
    font-variant-numeric: tabular-nums;
  }

  .td-stage-zone {
    color: var(--blume-muted-foreground);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    margin: 0 0 0.25rem;
    text-transform: uppercase;
  }

  .td-stage-title {
    color: var(--blume-foreground);
    font-weight: 500;
    margin: 0;
  }

  .td-stage-detail {
    color: var(--blume-muted-foreground);
    font-size: 0.75rem;
    margin: 0.25rem 0 0;
  }

  .td-stage-privacy {
    border-top: 1px solid color-mix(in oklab, var(--td-accent) 35%, transparent);
    color: var(--blume-foreground);
    font-size: 0.75rem;
    margin: 0.5rem 0 0;
    padding-top: 0.5rem;
  }

  .td-stage-privacy code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .td-pipeline--privacy [data-privacy]:not(.td-stage--group) {
    border-color: color-mix(in oklab, var(--td-accent) 70%, transparent);
    box-shadow: inset 3px 0 0 var(--td-accent);
  }

  .td-pipeline--privacy .td-stage:not([data-privacy]),
  .td-pipeline--privacy .td-step:not([data-privacy]) {
    opacity: 0.55;
  }

  .td-link {
    align-items: center;
    display: flex;
    gap: 0.625rem;
    min-height: 1.75rem;
    padding-inline-start: 1.25rem;
  }

  .td-link-line {
    align-self: stretch;
    background: var(--blume-border);
    position: relative;
    width: 1px;
  }

  .td-link-line::after {
    border-inline: 4px solid transparent;
    border-top: 5px solid var(--blume-muted-foreground);
    bottom: -1px;
    content: "";
    left: -4px;
    position: absolute;
  }

  .td-link-label {
    color: var(--blume-muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding-block: 0.375rem;
  }
</style>
