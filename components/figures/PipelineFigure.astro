---
import { PIPELINE } from "./model.js";

interface Props {
  title: string;
  caption?: string;
  /** `privacy` adds a note to each stage that removes content and marks its node. */
  focus?: "privacy";
}

const { title, caption, focus } = Astro.props;
const privacy = focus === "privacy";
const codeSpans = (text: string) =>
  text.split(/(`[^`]+`)/u).map((piece) => ({ code: piece.startsWith("`"), text: piece.replaceAll("`", "") }));
const zones = [
  { label: "In your process", stages: [PIPELINE.app] },
  { label: "telemetry.dev ingest", stages: PIPELINE.ingest, transport: PIPELINE.transport },
  { label: "telemetry.dev storage", stages: [PIPELINE.store] },
];
---

<figure class="td-figure not-prose">
  <div class="td-figure-card">
    <p class="td-figure-title">{title}</p>
    <ol class="td-flow">
      {
        zones.map((zone) => (
          <>
            {zone.transport && (
              <li class="td-flow-transport">
                <span class="td-flow-transport-label">{zone.transport}</span>
              </li>
            )}
            <li class="td-flow-zone" aria-hidden="true">
              {zone.label}
            </li>
            {zone.stages.map((stage) => {
              const note = privacy ? stage.privacy : undefined;
              return (
                <li class="td-flow-stage" data-removes={note ? "" : undefined}>
                  <span class="td-flow-node" aria-hidden="true" />
                  <p class="td-flow-title">{stage.title}</p>
                  <p class="td-flow-detail">{stage.detail}</p>
                  {note && (
                    <p class="td-flow-note">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3 5 6v5c0 4.4 2.9 8.4 7 10 4.1-1.6 7-5.6 7-10V6l-7-3Z" />
                      </svg>
                      <span>
                        {codeSpans(note).map((piece) => (piece.code ? <code>{piece.text}</code> : piece.text))}
                      </span>
                    </p>
                  )}
                </li>
              );
            })}
          </>
        ))
      }
    </ol>
  </div>
  {caption && <figcaption class="td-figure-caption">{caption}</figcaption>}
</figure>

<style>
  .td-flow {
    --td-rail-x: 0.3125rem;
    --td-node-y: 1.0625rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* The rail is drawn per row so it can start at the first node, end at the last, and turn dashed for the network hop. */
  .td-flow > li:not(:first-child)::before {
    background: var(--blume-border);
    bottom: 0;
    content: "";
    left: var(--td-rail-x);
    position: absolute;
    top: 0;
    width: 1px;
  }

  .td-flow > li:nth-child(2)::before {
    top: var(--td-node-y);
  }

  .td-flow > li:last-child::before {
    bottom: auto;
    height: var(--td-node-y);
  }

  .td-flow > li {
    padding-inline-start: 1.75rem;
    position: relative;
  }

  .td-flow-zone {
    color: var(--blume-muted-foreground);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding-block: 0.25rem 0.375rem;
    text-transform: uppercase;
  }

  .td-flow-stage {
    padding-block: 0.375rem 0.75rem;
  }

  .td-flow-node {
    background: var(--blume-background);
    border: 1.5px solid var(--blume-muted-foreground);
    border-radius: 999px;
    height: 0.625rem;
    left: calc(var(--td-rail-x) + 0.5px - 0.3125rem);
    position: absolute;
    top: calc(var(--td-node-y) - 0.3125rem);
    width: 0.625rem;
    z-index: 1;
  }

  .td-flow-stage[data-removes] .td-flow-node {
    background: var(--td-accent);
    border-color: var(--td-accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--td-accent) 22%, transparent);
  }

  .td-flow-title {
    color: var(--blume-foreground);
    font-weight: 500;
    margin: 0;
  }

  .td-flow-detail {
    color: var(--blume-muted-foreground);
    margin: 0.125rem 0 0;
  }

  .td-flow-note {
    align-items: flex-start;
    background: color-mix(in oklab, var(--td-accent) 11%, transparent);
    border-radius: 0.375rem;
    color: var(--blume-foreground);
    display: flex;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0.375rem 0.625rem;
    width: fit-content;
  }

  .td-flow-note svg {
    color: var(--td-accent);
    flex: none;
    height: 0.875rem;
    margin-top: 0.15rem;
    width: 0.875rem;
  }

  .td-flow-note code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .td-flow-transport {
    padding-block: 0.5rem 0.875rem;
  }

  .td-flow > .td-flow-transport::before {
    background: none;
    border-left: 1px dashed var(--blume-muted-foreground);
    width: 0;
  }

  .td-flow-transport-label {
    background: var(--blume-background);
    border: 1px solid var(--blume-border);
    border-radius: 999px;
    color: var(--blume-muted-foreground);
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.125rem 0.625rem;
  }
</style>
