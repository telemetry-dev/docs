---
import { costParts, formatPrice, formatTokens, formatUsd } from "./model.js";

interface Props {
  title: string;
  caption?: string;
  input: number;
  cacheRead?: number;
  cacheWrite?: number;
  output: number;
  /** US dollars per 1,000,000 tokens, using the pricing snapshot's field names. */
  prices: { input: number; cachedInput?: number; cacheWrite?: number; output: number };
}

const { title, caption, ...usage } = Astro.props;
const { parts, totalTokens, totalUsd } = costParts(usage);
const share = (value: number, total: number) => `${((value / total) * 100).toFixed(2)}%`;
const bars = [
  { label: "Tokens", total: formatTokens(totalTokens), width: (part: (typeof parts)[number]) => share(part.tokens, totalTokens) },
  { label: "Cost", total: formatUsd(totalUsd), width: (part: (typeof parts)[number]) => share(part.usd, totalUsd) },
];
---

<figure class="td-figure not-prose">
  <div class="td-figure-card">
    <p class="td-figure-title">{title}</p>
    <div class="td-cost-bars" aria-hidden="true">
      {
        bars.map((bar) => (
          <div class="td-cost-bar">
            <span class="td-cost-bar-label">{bar.label}</span>
            <span class="td-cost-bar-track">
              {parts.map((part) => (
                <span class="td-cost-segment" data-part={part.key} style={`width: ${bar.width(part)}`} />
              ))}
            </span>
            <span class="td-cost-bar-total">{bar.total}</span>
          </div>
        ))
      }
    </div>
    <table class="td-cost-table">
      <thead>
        <tr>
          <th scope="col">Token part</th>
          <th scope="col">Tokens</th>
          <th scope="col">Price per 1M</th>
          <th scope="col">Cost</th>
        </tr>
      </thead>
      <tbody>
        {
          parts.map((part) => (
            <tr data-part={part.key}>
              <th scope="row">
                <span class="td-cost-swatch" aria-hidden="true" />
                {part.label}
              </th>
              <td>{formatTokens(part.tokens)}</td>
              <td>{formatPrice(part.price)}</td>
              <td>{formatUsd(part.usd)}</td>
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">Total</th>
          <td>{formatTokens(totalTokens)}</td>
          <td />
          <td>{formatUsd(totalUsd)}</td>
        </tr>
      </tfoot>
    </table>
  </div>
  {caption && <figcaption class="td-figure-caption">{caption}</figcaption>}
</figure>

<style>
  [data-part="uncached"] { --td-part: oklch(0.62 0.17 255); }
  [data-part="cacheRead"] { --td-part: oklch(0.78 0.11 200); }
  [data-part="cacheWrite"] { --td-part: oklch(0.76 0.15 75); }
  [data-part="output"] { --td-part: oklch(0.62 0.2 300); }

  .td-cost-bars {
    display: grid;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }

  .td-cost-bar {
    align-items: center;
    display: grid;
    font-size: 0.75rem;
    gap: 0.75rem;
    grid-template-columns: 3.25rem minmax(0, 1fr) 5.5rem;
  }

  .td-cost-bar-label {
    color: var(--blume-muted-foreground);
  }

  .td-cost-bar-total {
    color: var(--blume-foreground);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .td-cost-bar-track {
    border-radius: 4px;
    display: flex;
    gap: 2px;
    height: 1.25rem;
    overflow: hidden;
  }

  .td-cost-segment {
    background: var(--td-part);
    min-width: 2px;
  }

  .td-cost-table {
    border-collapse: collapse;
    font-size: 0.75rem;
    width: 100%;
  }

  .td-cost-table :is(th, td) {
    border-top: 1px solid color-mix(in oklab, var(--blume-border) 70%, transparent);
    padding: 0.4375rem 0.25rem;
    text-align: end;
    white-space: nowrap;
  }

  .td-cost-table :is(th, td):first-child {
    text-align: start;
  }

  .td-cost-table thead th {
    border-top: 0;
    color: var(--blume-muted-foreground);
    font-weight: 400;
  }

  .td-cost-table tbody th,
  .td-cost-table tfoot th {
    color: var(--blume-foreground);
    font-weight: 400;
  }

  .td-cost-table td {
    color: var(--blume-foreground);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .td-cost-table tfoot :is(th, td) {
    border-top-color: var(--blume-border);
    font-weight: 600;
  }

  .td-cost-swatch {
    background: var(--td-part);
    border-radius: 2px;
    display: inline-block;
    height: 0.625rem;
    margin-inline-end: 0.5rem;
    vertical-align: -0.0625rem;
    width: 0.625rem;
  }

  @media (max-width: 30rem) {
    .td-cost-table {
      font-size: 0.6875rem;
    }

    .td-cost-bar {
      grid-template-columns: 2.75rem minmax(0, 1fr) 4.75rem;
    }
  }
</style>
